<%- include('../partials/header.ejs') %>

<div class="container">
  <h1>Mobile & Tablets</h1>
  <hr>

  <div class="product-grid" style="display: flex; gap: 20px; flex-wrap: wrap;">
    <% if (products.length > 0) { %>

      <% products.forEach(product => { %>
        <div class="product-card" style="border: 1px solid #ccc; padding: 15px; border-radius: 8px; width: 200px;">
          <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 100%; height: auto;">

          <h3><%= product.name %></h3>
          <p>Price: <strong><%= product.price %> BHD</strong></p>

          <a href="/products/<%= product._id %>" class="btn">View Details</a>
        </div>
      <% }) %>

    <% } else { %>
      <div class="no-products">
        <p>No mobile products found. Try adding some from the "New Product" page!</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer.ejs') %>
