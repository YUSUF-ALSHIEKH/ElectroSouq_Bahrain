<%- include('../partials/header.ejs') %>

<h2><%= product.title %></h2>
<img src="<%= product.image %>" alt="<%= product.title %>" width="300" />
<p>Description:<%= product.description %></p>
<p>Price:<%= product.price %>BD</p>
<p>Number:+973<%= product.number%></p>

<% if (user._id === product.author._id.toString()) { %>

<form action="/products/<%= product._id %>/edit">
  <button>Edit</button>
</form>

<form action="/products/<%= product._id %>?_method=DELETE" method="POST">
  <button type="submit">Delete</button>
</form>



<% } %>

<form action="/comments/<%= product._id %>">
  <button>Create Comment</button>
</form>
<%if (comments.length===0){%>
  <div>
  <h3>NO Comments</h3>
  </div>
  <% } else { %>
    <h3>Comments</h3>
<%comments.forEach(comment=>{%>
  <div style="border: 2px; border-top: 2px solid #000; margin-top: 5px;">
    <p><%= comment.author.first%>: <%= comment.description%></p>
  </div>
  <%})%>
<%}%>
<%- include('../partials/footer.ejs') %>
