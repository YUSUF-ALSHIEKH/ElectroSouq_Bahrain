<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ElectroSouq_Bahrain</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <nav>

      <% if (!user) { %>

      <a href="/auth/sign-up">Sign Up</a>
      <a href="/auth/sign-in">Sign In</a>

      <% } else { %>
<a href="/products/home">Home</a>
<a href="/products/new">New Product</a>
      <a href="/auth/sign-out">Sign Out</a>


      <% } %>

    </nav>
    <main>


<h2><%= user.first %> <%= user.last %>'s Profile</h2>
<% if(user.picture){%>
<img src="<%= user.picture %>" alt="Profile Picture" width="150" />


<%} else {%>
<img src="/Pictures/download.png" alt="Profile Picture" width="150" />
<%} %>

<h3>Products :</h3>
<ul>
  <% user.products.forEach(product => { %>
    <li><a href="/products/<%= product._id %>"><%= product.title %></a></li>
  <% }) %>
</ul>
<%- include('../partials/footer.ejs') %>
